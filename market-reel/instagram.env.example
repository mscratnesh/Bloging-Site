# Instagram credentials for the daily market reel (market_reel.py, run by the site server).
# Copy this file to instagram.env NEXT TO LetMoneyEarn.exe (in dist\ on the server) and fill in both values.
# instagram.env is git-ignored. Never commit or share the token, and never put it in this file.
#
# Both come from your Meta developer app -> "API setup with Instagram login" page:
#   INSTAGRAM_USER_ID  the numeric account id shown under your Instagram account
#   INSTAGRAM_TOKEN    the token from "Generate token" (valid 60 days; paste a new one before it expires)
#
# Without this file the server builds no reel and posts nothing.

INSTAGRAM_USER_ID=
INSTAGRAM_TOKEN=
